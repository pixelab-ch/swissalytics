{
  "name": "swissalytics",
  "version": "1.0.0",
  "description": "Swissalytics — Analyse SEO & AI Search gratuite",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node -e \"const fs=require('fs'),{spawnSync}=require('child_process');const env={...process.env,RUN_LIVE_INTEGRATIONS:'1'};fs.readFileSync('.env.local','utf8').split('\\n').forEach(l=>{const m=l.match(/^([A-Z_]+)=(.*)$/);if(m)env[m[1]]=m[2].replace(/^['\\\"]|['\\\"]$/g,'')});process.exit(spawnSync('vitest',['run','src/lib/integrations/'],{env,stdio:'inherit'}).status)\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.19",
    "gray-matter": "^4.0.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.427.0",
    "nanoid": "^5.1.9",
    "next": "^15.3.3",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reading-time": "^1.5.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
